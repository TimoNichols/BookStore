{
  "openapi": "3.1.1",
  "info": {
    "title": "BookStore.API | v1",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://localhost:7247"
    },
    {
      "url": "http://localhost:5033"
    }
  ],
  "paths": {
    "/api/Book": {
      "get": {
        "tags": [
          "Book"
        ],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32",
              "default": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32",
              "default": 5
            }
          },
          {
            "name": "sortOrder",
            "in": "query",
            "schema": {
              "type": "string",
              "default": "asc"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Book"
    }
  ]
}